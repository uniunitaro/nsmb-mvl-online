{
  "name": "bigstar",
  "version": "0.11.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri-edition.mjs dev --edition insiders --build-profile local",
    "dev:local": "node scripts/tauri-edition.mjs dev --edition insiders --build-profile local",
    "dev:local:insiders": "node scripts/tauri-edition.mjs dev --edition insiders --build-profile local",
    "dev:local:public": "node scripts/tauri-edition.mjs dev --edition public --build-profile local",
    "dev:distribution": "node scripts/tauri-edition.mjs dev --edition insiders --build-profile distribution",
    "dev:distribution:insiders": "node scripts/tauri-edition.mjs dev --edition insiders --build-profile distribution",
    "dev:distribution:public": "node scripts/tauri-edition.mjs dev --edition public --build-profile distribution",
    "dev:insiders": "node scripts/tauri-edition.mjs dev --edition insiders --build-profile local",
    "dev:public": "node scripts/tauri-edition.mjs dev --edition public --build-profile local",
    "prepare": "panda codegen",
    "build": "node scripts/tauri-edition.mjs build --edition insiders --build-profile local",
    "build:local": "node scripts/tauri-edition.mjs build --edition insiders --build-profile local",
    "build:local:insiders": "node scripts/tauri-edition.mjs build --edition insiders --build-profile local",
    "build:local:public": "node scripts/tauri-edition.mjs build --edition public --build-profile local",
    "build:distribution": "node scripts/tauri-edition.mjs build --edition insiders --build-profile distribution",
    "build:distribution:insiders": "node scripts/tauri-edition.mjs build --edition insiders --build-profile distribution",
    "build:distribution:public": "node scripts/tauri-edition.mjs build --edition public --build-profile distribution",
    "build:insiders": "node scripts/tauri-edition.mjs build --edition insiders --build-profile distribution",
    "build:public": "node scripts/tauri-edition.mjs build --edition public --build-profile distribution",
    "sync:sidecars": "node scripts/sync-sidecars.mjs",
    "panda:codegen": "panda codegen",
    "typecheck": "tsc --noEmit",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "test:unit": "vitest --config vitest.config.ts run",
    "test:editions": "node --test scripts/edition-policy.test.mjs",
    "version:set": "node scripts/set-version.mjs",
    "verify:nsis-migration": "node scripts/verify-nsis-migration.mjs",
    "test:browser": "vitest --config vitest.browser.config.ts run",
    "test:e2e": "playwright test",
    "ci": "tsc --noEmit && biome check . && node --test scripts/edition-policy.test.mjs && vitest --config vitest.config.ts run && vitest --config vitest.browser.config.ts run && playwright test",
    "vite:build": "vite build",
    "vite:dev": "vite --host 127.0.0.1",
    "preview:browser": "vite --host 127.0.0.1 --port 1421"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "hono": "^4.12.23",
    "lucide-react": "^1.17.0",
    "nuqs": "2.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hotkeys-hook": "^5.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@cloudflare/workers-types": "^4.20260605.1",
    "@pandacss/dev": "^1.11.1",
    "@park-ui/panda-preset": "^0.43.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.1.8",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "vitest-browser-react": "^2.2.0"
  },
  "packageManager": "pnpm@10.26.2"
}
