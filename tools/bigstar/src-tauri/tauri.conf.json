{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bigstar Insiders",
  "version": "0.11.4",
  "identifier": "io.github.bigstar-project.bigstar.insiders",
  "build": {
    "beforeDevCommand": "corepack pnpm vite:dev",
    "beforeBuildCommand": "corepack pnpm sync:sidecars && corepack pnpm vite:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bigstar",
        "width": 1120,
        "height": 760,
        "minWidth": 920,
        "minHeight": 680,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Bigstar Project",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/melonDS",
      "binaries/bigstar-net-bridge"
    ],
    "resources": {
      "../../../tests/nsmb_us_direct_mvl_minimal_bootstrap.inputs": "resources/nsmb_us_direct_mvl_minimal_bootstrap.inputs",
      "resources/notification_sound.wav": "resources/notification_sound.wav",
      "../../../tools/bigstar-rom/resources/symbols9.x": "resources/symbols9.x"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2MkQwMjI0MkE0QTg3MTgKUldRWWgwb3FKQUl0RnFzVDRZUHZGMldCc2NwVTdsRlBpWit6bGxiak9DeGxiUTY4YU9hRFlkYW4K",
      "endpoints": [
        "https://github.com/bigstar-project/bigstar/releases/download/insiders-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
